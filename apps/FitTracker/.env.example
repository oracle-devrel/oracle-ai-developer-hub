# Copy to .env (make setup does this). Values match docker-compose.yml.
APP_ENV=development
DEBUG=true

# Oracle Database
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=fittrack
ORACLE_PASSWORD=FitTrack2026!

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production
ADMIN_API_KEY=dev-admin-key-change-in-production

# Terra API (only needed to connect real fitness trackers)
TERRA_API_KEY=
TERRA_DEV_ID=
TERRA_WEBHOOK_SECRET=

# Email (Mailpit in docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
