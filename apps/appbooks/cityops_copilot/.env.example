# Optional. The appbook already reads the notebook's .env in
# notebooks/agent_memory/cityops_copilot/; copy this to .env in this folder (ignored by
# git) only to give the app different settings.
# Order: environment variables, then this folder's .env, then the notebook's.

# Oracle AI Database: a user with the ONNX embedding model loaded (the notebook uses prism)
DBPASSWORD=
DB_DSN=localhost:1522/FREEPDB1
# DBUSER=prism
# ONNX_MODEL=ALL_MINILM_L12_V2

# Ollama: llama3.2 serves both the SDK's extractor and the copilot
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# The appbook's own tables; never CITY_ (that prefix belongs to the notebook)
APPBOOK_TABLE_PREFIX=CITYAPP_
# Findings loaded on first start (the dataset has 222; the notebook loads 15)
DEMO_FINDING_COUNT=15
