# Optional. The appbook already reads the notebook's .env in
# notebooks/agent_memory/inventory_handover/; copy this to .env in this folder (ignored by
# git) only to give the app different settings.
# Order: environment variables, then this folder's .env, then the notebook's.

# Oracle AI Database (the notebook's prism user and ALL_MINILM_L12_V2 model)
DBPASSWORD=
DB_DSN=localhost:1522/FREEPDB1
# DBUSER=prism

# OCI Generative AI: an API key (works only in the region it was created in) …
OCI_GENAI_API_KEY=
ENDPOINT=https://inference.generativeai.us-phoenix-1.oci.oraclecloud.com
# … or OCI config-file signing with a compartment
# OCI_CONFIG_FILE=~/.oci/config
# COMPARTMENT_OCID=
OCI_GENAI_MODEL=xai.grok-4.3

# The appbook's own OAMP store; never ZH_INVENTORY (the notebook's)
APPBOOK_STORE=INVAPP
