# Learning example setup settings. Never commit a populated copy.
# The running web process loads .deepsec.runtime.env instead of this file.

# Shared Autonomous AI Database target.
OAM_DEEPSEC_DSN=<TNS-alias-or-Easy-Connect-string>
# Optional when the DSN uses tnsnames.ora.
OAM_DEEPSEC_CONFIG_DIR=<directory-containing-tnsnames.ora>
# Optional when the wallet is not fully configured by sqlnet.ora.
OAM_DEEPSEC_WALLET_LOCATION=<wallet-directory>
OAM_DEEPSEC_WALLET_PASSWORD=<wallet-password>

# Existing security administrator. Setup and policy administration only.
OAM_DEEPSEC_ADMIN_USER=ADMIN
OAM_DEEPSEC_ADMIN_PASSWORD=<security-administrator-password>

# The account setup script creates these two new users.
OAM_DEEPSEC_OWNER_USER=OAM_SCHEMA_OWNER
OAM_DEEPSEC_OWNER_PASSWORD=<schema-owner-password>
OAM_DEEPSEC_APP_DB_USER=OAM_APP_DB_USER
OAM_DEEPSEC_APP_POOL_PASSWORD=<application-pool-password>

# OCI IAM database resource application.
OAM_DEEPSEC_OCI_DB_APP_ID=<database-resource-application-id>
OAM_DEEPSEC_OCI_DOMAIN_URL=https://<identity-domain-host>:443
OAM_DEEPSEC_OCI_DB_CLIENT_ID=<database-resource-client-id>
OAM_DEEPSEC_OCI_DB_CLIENT_SECRET=<database-resource-client-secret>

# OCI IAM group containing Alice and Bob.
OAM_DEEPSEC_OCI_IAM_GROUP=ORACLEAGENTMEMORY_USERS

# Confidential web application. Register this exact redirect URI:
# http://127.0.0.1:8000/auth/callback
OAM_WEB_OCI_CLIENT_ID=<web-application-client-id>
OAM_WEB_OCI_CLIENT_SECRET=<web-application-client-secret>
OAM_WEB_OCI_END_USER_SCOPE=OracleAgentMemoryWebAPP_ACCESS_SCOPE
OAM_WEB_OCI_DATABASE_ACCESS_SCOPE=OracleDBDB_ACCESS_SCOPE

# Flask demo settings.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OAM_WEB_SECRET_KEY=<at-least-32-random-characters>
OAM_WEB_BASE_URL=http://127.0.0.1:8000
OAM_WEB_HOST=127.0.0.1
OAM_WEB_PORT=8000

# Agent Memory store and embedding provider.
OAM_WEB_MEMORY_STORE_ID=OAM_IAM_WEB
OAM_WEB_EMBEDDING_MODEL=openai/text-embedding-3-small
OAM_WEB_EMBEDDING_API_KEY=<embedding-provider-api-key>
# Optional for an OpenAI-compatible endpoint.
OAM_WEB_EMBEDDING_API_BASE=
# Set this to avoid an embedding-provider probe during schema setup.
OAM_WEB_EMBEDDING_DIMENSION=1536
