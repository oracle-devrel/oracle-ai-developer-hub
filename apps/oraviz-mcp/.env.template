# Local development only. Copy with umask 077; never commit secrets or source this file.
# Use a dedicated account with CREATE SESSION and READ grants on approved objects.
ORACLE_USER=oraviz_reader
# Inject ORACLE_PASSWORD through the runtime environment or fill a protected local file.
ORACLE_PASSWORD=

# Connection target (defaults shown)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1

# Optional: full EZConnect descriptor; overrides host/port/service
# ORACLE_DSN=myhost:1521/FREEPDB1

# Optional: Oracle wallet (Autonomous Database / mTLS)
# ORACLE_CONFIG_DIR=/wallet
# ORACLE_WALLET_LOCATION=/wallet/credentials
# ORACLE_WALLET_PASSWORD=wallet_password

# Optional: bounded numeric settings; invalid values fall back to defaults.
# Rows: 1..5000; cell characters: 1..4096; columns: 1..200.
ORACLE_MCP_MAX_ROWS=500
ORACLE_MCP_PREVIEW_ROWS=25
ORACLE_MCP_MAX_CELL_CHARS=500
ORACLE_MCP_MAX_RESULT_COLUMNS=64
# Maximum admitted tool calls per process: 1..32.
ORACLE_MCP_MAX_CONCURRENT=4
# Unset enables all seven; empty or unknown names reject startup.
ORACLE_MCP_ALLOWED_TOOLS=execute_query,list_tables,get_table_schema,sample_table_data,get_table_details,profile_table,create_chart
# Seconds; call timeout 1..300, per database round trip, never a whole-tool deadline.
ORACLE_CONNECT_TIMEOUT=10
ORACLE_CALL_TIMEOUT=60

# Optional: MCP server transport (stdio is the default)
ORACLE_MCP_SERVER_TRANSPORT=stdio
ORACLE_MCP_BIND_HOST=127.0.0.1
ORACLE_MCP_BIND_PORT=8080

# Required for EVERY network transport, including loopback and proxy deployments.
# Replace these placeholders with your IdP's HTTPS endpoints and resource audience.
# ORACLE_MCP_AUTH_ISSUER=https://idp.example/realms/agents
# ORACLE_MCP_AUTH_AUDIENCE=oraviz-mcp
# ORACLE_MCP_AUTH_JWKS_URL=https://idp.example/realms/agents/protocol/openid-connect/certs
# Space-separated required scopes (tool allowlist above is comma-separated).
# ORACLE_MCP_AUTH_REQUIRED_SCOPES=oraviz:read
# Optional HTTPS public base URL for discovery; omit /mcp and /sse.
# ORACLE_MCP_AUTH_BASE_URL=https://mcp.example/oraviz
# See SECURITY.md for TLS, private network, egress, gateway limits, and audit setup.

# Optional: logging (json is the default; set LOG_FORMAT=console for humans)
# LOG_FORMAT=json
# LOG_LEVEL=20
