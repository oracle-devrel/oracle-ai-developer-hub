# Copy to .env (or export) to override the defaults. Everything below already
# defaults to the local docker-compose container, so a fresh clone needs nothing.

# --- Oracle AI Database (docker-compose.yml) ---
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=TEAMBRAIN
ORACLE_PASSWORD=TeamBrain123
# The test suite uses its own schema so it never wipes the dev knowledge base.
ORACLE_USER_TEST=TEAMBRAIN_TEST
ORACLE_PASSWORD_TEST=TeamBrain123

# --- Embeddings: the ONNX model loaded into the database by scripts/bootstrap_db.py
EMBEDDING_MODEL=ALL_MINILM_L12_V2
# EMBEDDING_DIMENSIONS=384
# EMBEDDING_MAX_CHARS=2000
# ONNX_URL=            # where bootstrap_db.py downloads the model zip from
# ORACLE_CONTAINER=team-brain-oracle   # bootstrap reads the SYS password off this container
# ORACLE_SYS_PASSWORD=                  # or set it explicitly

# --- Retrieval tuning ---
# RRF_K=60
# AGE_HALF_LIFE_DAYS=180
# SEARCH_DEFAULT_LIMIT=10

# --- CLI default identity when no --as/--token/--user is given (ACL-only, no domain grant)
# TEAMBRAIN_DEFAULT_USER=demo

# --- Retrieval legs: "langchain" (OracleVS + OracleTextSearchRetriever) or "sql"
RETRIEVAL_BACKEND=langchain

# --- Agent LLM (optional). Any OpenAI-compatible endpoint; OpenRouter by default.
# Without a key the CLI agent and enrichment run in deterministic offline mode.
# LLM_API_KEY=            # or OPENROUTER_API_KEY, either works
# OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# PLANNER_MODEL=anthropic/claude-haiku-4.5
# SYNTH_MODEL=anthropic/claude-sonnet-4.6

# --- Connectors (optional) ---
# GITHUB_TOKEN=
# SLACK_BOT_TOKEN=

# --- MCP service (team-brain serve) ---
TEAMBRAIN_MCP_HOST=127.0.0.1
TEAMBRAIN_MCP_PORT=8765
# stdio transport: the identity for this process (HTTP uses the bearer token instead)
# TEAM_BRAIN_TOKEN=
