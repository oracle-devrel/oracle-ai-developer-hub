# Copy to .env beside the notebook (ignored by git). The appbook reads it too.

# Oracle AI Database: a user with the ALL_MINILM_L12_V2 ONNX model in its schema
DBUSER=prism
DBPASSWORD=
DB_DSN=localhost:1522/FREEPDB1

# OCI Generative AI: an API key (valid only in the region it was created in;
# set ENDPOINT to that region) ...
OCI_GENAI_API_KEY=
ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
# ... or OCI config-file signing with a compartment
# OCI_CONFIG_FILE=~/.oci/config
# COMPARTMENT_OCID=
OCI_GENAI_MODEL=xai.grok-4.3
