# VecDB
VECDB_REST_URL=
VECDB_USERNAME=
VECDB_PASSWORD=
VECDB_SELF_SIGNED_SSL=false

# PASC
PASC_HOST=
PASC_API_KEY=
PASC_CERT=
PASC_MODEL=

# Optional cleanup
DROP_TABLE_WHEN_DONE=false

# Optional proxies: leave these commented out unless your network requires a proxy
