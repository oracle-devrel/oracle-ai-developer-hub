# Copy to .env for local development. Never commit real secrets.

# Oracle database connection settings
# The container bootstrap creates this dedicated application schema.
ORACLE_USER=TUTORIAL_USER
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1

# LLM configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CORPUS_VERSION=2026.1

# Tutorial/demo identifiers
DEMO_USER_ID=user_a
DEMO_THREAD_ID=thread_a
