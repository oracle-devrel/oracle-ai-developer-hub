# Copy to .env for local development. Never commit real secrets.

# Oracle Autonomous AI Database Serverless connection settings
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
# TNS alias from the wallet tnsnames.ora file, for example mydb_low
ORACLE_DSN=
# Absolute path to the extracted instance wallet directory
ORACLE_WALLET_DIR=
# Password used to download the instance wallet
ORACLE_WALLET_PASSWORD=

# LLM configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CORPUS_VERSION=2026.1

# Tutorial/demo identifiers
DEMO_USER_ID=user_a
DEMO_THREAD_ID=thread_a
