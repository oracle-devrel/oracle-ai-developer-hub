{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paris Dataset document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "title",
    "body",
    "topic",
    "place",
    "source_url",
    "source_publisher",
    "retrieved_at",
    "license_basis",
    "license_url",
    "content_hash"
  ],
  "properties": {
    "document_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "topic": { "enum": ["museum", "neighbourhood", "food", "transit", "history"] },
    "place": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "source_publisher": { "type": "string", "minLength": 1 },
    "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "license_basis": {
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "Etalab-2.0",
        "ODbL-1.0",
        "permission",
        "link-only",
        "public-domain"
      ]
    },
    "license_url": { "type": "string", "format": "uri" },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
